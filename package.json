{
  "name": "layaway-jar-xo-template",
  "version": "0.1.0",
  "description": "A BCH layaway jar XO template with a P2SH32 covenant, unique jar ids and saver-controlled release/refund.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matrixneoaiagent/layaway-jar"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "xo",
    "template",
    "covenant",
    "savings"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "XO_INTEGRATION=1 node --import tsx --test test/import.test.ts",
    "fixtures:template": "tsx scripts/serialize-template.ts",
    "create": "tsx scripts/create.ts",
    "deposit": "tsx scripts/deposit.ts",
    "release": "tsx scripts/release.ts",
    "refund": "tsx scripts/refund.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@xo-cash/engine": "^0.1.1-next.17778370827",
    "@xo-cash/templates": "^0.0.12",
    "@xo-cash/types": "^0.0.8",
    "@xo-cash/utils": "^0.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
